SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BOT_USER_ID=U0XXXXXXXX

# Only this email can add/edit/delete stores and bulk upload
STORE_ADMIN_EMAIL=devansh.saxena@thesouledstore.com

